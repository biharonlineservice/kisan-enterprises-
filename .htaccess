# ----------------------------------------------------------------------
# Kisan Enterprises ERP & Business Website
# XAMPP & Shared Hosting Root Forwarder & Security Rules
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^(\.git|storage|bootstrap\/cache) - [F,L,NC]

    # Automatically redirect requests from the project root into public/
    RewriteCond %{REQUEST_URI} !/public/ [NC]
    RewriteRule ^(.*)$ "/kisan enterprises/public/$1" [L,R=302,NE]
</IfModule>

Options -Indexes
